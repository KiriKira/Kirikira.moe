---
import { CATEGORY_ORDER, FRIENDS, SIDEBAR_LINKS, SITE } from '../site';
import ThemeToggle from './ThemeToggle.astro';
import { categoryUrl, getPosts, groupBy } from '../lib/posts';

const posts = await getPosts();
const rank = (name: string) => (CATEGORY_ORDER.includes(name) ? CATEGORY_ORDER.indexOf(name) : CATEGORY_ORDER.length);
const categories = [...groupBy(posts, (p) => [p.data.category])].sort(
  (a, b) => rank(a[0]) - rank(b[0]) || b[1].length - a[1].length,
);
---

<aside class="sidebar">
  <a class="widget love-kiri shake" href={SITE.loveKiriHref}>
    <video src="/img/kiri.mp4" poster="/img/kiri.jpg" width="640" height="640" muted loop playsinline preload="none"></video>
    <ul class="dotted"><li><span>Love Kiri!</span></li></ul>
  </a>

  <section class="widget">
    <h2 class="widget-title">分类</h2>
    <ul class="dotted chips-on-mobile">
      {
        categories.map(([name, list]) => (
          <li>
            <a href={categoryUrl(name)}>
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget">
    <h2 class="widget-title">功能</h2>
    <ul class="chips-on-mobile">
      {
        SIDEBAR_LINKS.map((l) => (
          <li>
            <a href={l.href}>{l.html ? <span set:html={l.html} /> : l.label}</a>
          </li>
        ))
      }
      <li><ThemeToggle /></li>
    </ul>
  </section>

  <section class="widget">
    <h2 class="widget-title">友情链接</h2>
    <ul class="dotted chips-on-mobile">
      {
        FRIENDS.map((f) => (
          <li>
            <a href={f.href} target="_blank" rel="noopener">
              {f.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</aside>

<script>
  // Play the sidebar clip only while it's on screen, and not at all for people who
  // asked for less motion or less data (they get the poster image).
  const video = document.querySelector<HTMLVideoElement>('.love-kiri video');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (video && !saveData && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  }
</script>
