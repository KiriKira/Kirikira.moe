---
import { SITE } from '../site';
import { categoryUrl, formatDateTime, tagUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { date, updated, category, tags, draft } = post.data;
---

<div class="meta">
  <time datetime={date.toISOString()}>
    on {formatDateTime(date)}
    {updated && updated.valueOf() - date.valueOf() > 86_400_000 && <span> · updated {formatDateTime(updated)}</span>}
  </time>
  <div class="meta-chips">
    <a class="chip category" href={categoryUrl(category)}>{category}</a>
    <a class="chip" href="/" title={`written by ${SITE.author}`}>{SITE.author}</a>
    {tags.map((t) => <a class="chip tag" href={tagUrl(t)}>{t}</a>)}
    {draft && <span class="chip" style="background: var(--accent); color: #fff">draft</span>}
  </div>
</div>
