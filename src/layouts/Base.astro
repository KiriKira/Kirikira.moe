---
import { Picture } from 'astro:assets';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import banner from '../assets/banner.jpg';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Hide the sidebar (admin pages). */
  bare?: boolean;
  noindex?: boolean;
}

const { title, description = SITE.description, image = '/img/kiri.jpg', type = 'website', publishedTime, bare = false, noindex = false } =
  Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `It's me, Kiri! | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const NAV = [
  { href: '/', label: '首页', active: path === '/' || path.startsWith('/page/') },
  { href: '/archives/', label: '归档', active: path.startsWith('/archives') },
  { href: '/rss.xml', label: 'RSS', active: false },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={SITE.feedTitle} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15191c" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Apply a saved light/dark choice before first paint (no flash). Default: follow the OS.
      try {
        const t = localStorage.getItem('kiri:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="banner" aria-hidden="true">
        <Picture
          src={banner}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="container identity">
        <div class="identity-text">
          <a class="site-title shake" href="/" title={`${SITE.title} - ${SITE.tagline}`}>{SITE.title}</a>
          <a class="site-tagline shake" href="/" title={`${SITE.title} - ${SITE.tagline}`}>{SITE.tagline}</a>
        </div>
        <nav class="site-nav" aria-label="主导航">
          {
            NAV.map((n) => (
              <a href={n.href} aria-current={n.active ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <div class="page">
      <div class="container">
        <slot name="top" />
        {
          bare ? (
            <main id="main">
              <slot />
            </main>
          ) : (
            <div class="layout">
              <main id="main">
                <slot />
              </main>
              <Sidebar />
            </div>
          )
        }
      </div>
    </div>

    <footer class="site-footer">
      <div class="container">
        <p>Copyright © {SITE.since}-{year} {SITE.author}.</p>
        <p>
          Theme inspired by <a href="http://mythem.es/" target="_blank" rel="noopener">myThem.es</a>. Powered by{' '}
          <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>{' '}&amp;{' '}
          <a href="https://www.cloudflare.com/" target="_blank" rel="noopener">Cloudflare</a>.
        </p>
      </div>
    </footer>

    <a class="to-top" href="#" aria-label="回到顶部" hidden>↑</a>

    <script>
      // Back-to-top button after scrolling past ~1.5 screens.
      const toTop = document.querySelector<HTMLAnchorElement>('.to-top')!;
      let ticking = false;
      addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            toTop.hidden = scrollY < innerHeight * 1.5;
            ticking = false;
          });
        },
        { passive: true },
      );
      toTop.addEventListener('click', (e) => {
        e.preventDefault();
        scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });

      // The Django site registered a caching service worker; make sure it is gone.
      navigator.serviceWorker?.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
    </script>
  </body>
</html>
