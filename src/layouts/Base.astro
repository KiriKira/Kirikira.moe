---
import { Picture } from 'astro:assets';
import Shell from './Shell.astro';
import Sidebar from '../components/Sidebar.astro';
import banner from '../assets/banner.jpg';

type Props = import('./Shell.astro').Props;
---

<Shell {...Astro.props}>
  <slot name="head" slot="head" />
  <Fragment slot="banner">
    <Picture
      src={banner}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 720, 1008, 1440, 1920]}
      sizes="(min-width: 993px) 70vw, (min-width: 601px) 85vw, 270px"
      loading="eager"
      fetchpriority="high"
    />
  </Fragment>
  <slot name="top" slot="top" />
  <div class="layout">
    <main id="main">
      <slot />
    </main>
    <Sidebar />
  </div>
</Shell>
