{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview-only worker name. Production is `kirikira-moe` (see main branch).
  "name": "kirikira-moe-preview",
  // Custom entry: wraps Astro's fetch handler and adds the daily cron job.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Return the prerendered 404 page for unknown static paths.
    "not_found_handling": "404-page",
    // SSR routes (admin pages, comment API) must reach the Worker even for HTML
    // navigations — otherwise `not_found_handling` intercepts them and the browser
    // gets the static 404 page while curl (Accept: */*) sees the real response.
    "run_worker_first": ["/admin/*", "/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      // Preview D1 database (separate from production `kirikira`).
      "database_name": "kirikira-preview",
      // Created with `npx wrangler d1 create kirikira-preview`.
      "database_id": "71448926-96fe-4b65-a7b3-336082e161c5",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 03:17 UTC daily: purge old spam (see src/worker.ts).
    "crons": ["17 3 * * *"]
  },
  "vars": {
    // Cloudflare Access team domain, e.g. "kiri.cloudflareaccess.com". Leave empty to
    // disable JWT checks in local dev ONLY (production refuses admin requests then).
    "ACCESS_TEAM_DOMAIN": "",
    // The Access application AUD tag protecting /admin/* and /api/admin/*.
    "ACCESS_AUD": "",
    // Days to keep comments marked as spam before the cron job deletes them.
    "SPAM_RETENTION_DAYS": "30"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, and in .dev.vars locally):
  //   COMMENT_SECRET  - random 32+ byte string; signs proof-of-work challenges and hashes IPs.
}
