{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview-only worker name. Production is `kirikira-moe` (see main branch).
  "name": "kirikira-moe-preview",
  // Custom entry: wraps Astro's fetch handler and adds the daily cron job.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Return the prerendered 404 page for unknown static paths.
    "not_found_handling": "404-page",
    // Admin (CMS, comment admin) and APIs must reach the Worker first: it gates /admine*
    // (src/worker.ts), and without this not_found_handling would answer HTML navigations
    // to SSR routes with the static 404 page.
    "run_worker_first": ["/admine", "/admine/*", "/api/*"]
  },
  // Workers AI: Clef-flash scores comments for spam (src/lib/comments/ai.ts).
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      // Preview D1 database (separate from production `kirikira`).
      "database_name": "kirikira-preview",
      // Created with `npx wrangler d1 create kirikira-preview`.
      "database_id": "71448926-96fe-4b65-a7b3-336082e161c5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access team domain, e.g. "kiri.cloudflareaccess.com". Leave empty to
    // disable JWT checks in local dev ONLY (production refuses admin requests then).
    "ACCESS_TEAM_DOMAIN": "",
    // The Access application AUD tag protecting /admine and /admine/*.
    "ACCESS_AUD": "",
    // "off" disables the Workers AI spam check (rules and proof of work still apply).
    "AI_SPAM_CHECK": "on",
    // Reply notification emails (docs/MIGRATION_RUNBOOK.md 7.4). Empty = off. Needs the
    // RESEND_API_KEY secret (free plan), or a "send_email" binding named EMAIL (Workers Paid).
    // e.g. "Kiri 的博客 <noreply@notify.kirikira.moe>"
    "MAIL_FROM": "Kiri 的博客 <noreply@notify.kirikira.moe>",
    // Max notification emails per 24 hours (Resend's free plan allows 100/day).
    "MAIL_DAILY_LIMIT": "90"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, and in .dev.vars locally):
  //   COMMENT_SECRET  - random 32+ byte string; signs proof-of-work challenges and hashes IPs.
  //   RESEND_API_KEY  - optional: sends reply notification emails (see MAIL_FROM).
  //   ADMIN_TOKEN     - preview deployments only (no Access on workers.dev): open
  //                     /admine/?token=<ADMIN_TOKEN> once to log in. Never set it in production.
}
