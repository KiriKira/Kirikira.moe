# Copy to .dev.vars for `npm run dev` / `wrangler dev`. Never commit .dev.vars.
COMMENT_SECRET=dev-only-change-me-0123456789abcdef
# Preview-style admin login for `wrangler dev --local` (open /admine/?token=...). Never set in production.
ADMIN_TOKEN=local-test-token-123
# Reply notification emails (off when unset). A real key sends real mail, even locally.
# MAIL_FROM=Kiri 的博客 <noreply@notify.kirikira.moe>
# RESEND_API_KEY=re_...
